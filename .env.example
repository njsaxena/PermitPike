# PermitPike environment variables. NO REAL VALUES IN THIS FILE.
# Local setup: cp .env.example .env   (one .env at the repo root; web, agent and db all read it)
# Vercel / Vultr: set the same keys in each host's dashboard.

# ---- Shared ---------------------------------------------------------------
# Tiger Data (Postgres + TimescaleDB). Use the pooled connection string, sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require

# ---- Gemini (extraction + agent) --------------------------------------------
# Read by @ai-sdk/google and the Mastra model router.
GOOGLE_GENERATIVE_AI_API_KEY=
# Model id used for document/photo extraction and the review agent.
GEMINI_MODEL=gemini-2.5-flash

# ---- Web (Vercel) -----------------------------------------------------------
# Vercel Blob store token for file uploads.
BLOB_READ_WRITE_TOKEN=
# Where the web app calls the review agent (POST $AGENT_URL/review). Leave empty to use the
# built-in stub, which writes a labeled placeholder recommendation 2 seconds after filing.
# Local Mastra dev server: http://localhost:4111
AGENT_URL=
# Shared secret sent as the x-permitpike-secret header from web -> agent.
AGENT_SHARED_SECRET=change-me-locally

# ---- Agent (Vultr) ----------------------------------------------------------
PORT=4111

# ---- Data -------------------------------------------------------------------
# Analyze Boston "Approved Building Permits" CSV download URL (see data/README.md).
BOSTON_PERMITS_CSV_URL=
