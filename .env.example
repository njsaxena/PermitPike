# PermitPike environment variables. NO REAL VALUES IN THIS FILE.
# Local setup: cp .env.example .env   (one .env at the repo root; web, agent and db all read it)
# Vercel / Vultr: set the same keys in each host's dashboard.

# ---- Shared ---------------------------------------------------------------
# Tiger Data (Postgres + TimescaleDB). Use the pooled connection string, sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require

# ---- Gemini (extraction + agent) --------------------------------------------
# Used by Gemini extraction and the Mastra model router.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional alias for the local extraction tester.
# GEMINI_API_KEY=
# Model id used for document/photo extraction and the review agent.
GEMINI_MODEL=gemini-3.8-flash

# ---- Web (Vercel) -----------------------------------------------------------
# Vercel Blob store token for file uploads.
BLOB_READ_WRITE_TOKEN=
# Standalone review agent URL (POST $AGENT_URL/review). Vercel Services injects
# INTERNAL_AGENT_URL for the agent in the same deployment.
# Without either URL, the web app writes a labeled placeholder recommendation.
# Local Mastra dev server: http://localhost:4111
AGENT_URL=
# Shared secret sent as the x-permitpike-secret header from web -> agent and web -> risk API.
AGENT_SHARED_SECRET=change-me-locally
# Optional closure-risk API base URL. Leave empty to store closureRisk as null.
RISK_API_URL=

# ---- Agent (Vultr) ----------------------------------------------------------
PORT=4111

