{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "agent": {
      "root": "agent",
      "framework": "mastra"
    },
    "web": {
      "root": "web",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "agent", "format": "url", "env": "INTERNAL_AGENT_URL" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
